# Stripe (nur Test-Modus, Schluessel beginnt mit sk_test_). Live-Keys werden abgelehnt,
# solange ALLOW_LIVE_STRIPE nicht auf "true" steht.
STRIPE_SECRET_KEY=sk_test_...
# Optional, nur fuer /api/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Oeffentliche URL der App (fuer Stripe-Redirects, Sitemap)
NEXT_PUBLIC_APP_URL=http://localhost:3000
